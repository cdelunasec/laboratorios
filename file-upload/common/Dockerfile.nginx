FROM php:8.2-fpm

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx libpng-dev libjpeg62-turbo-dev libzip-dev \
    && docker-php-ext-configure gd --with-jpeg \
    && docker-php-ext-install gd zip \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

ARG LEVEL
ENV LAB_ID=file-upload-${LEVEL}

COPY common/entrypoint.sh /usr/local/bin/lab-entrypoint
COPY common/lab.php /var/www/lab/lab.php
COPY common/assets/ /var/www/html/assets/
COPY level${LEVEL}/nginx.conf /etc/nginx/conf.d/lab.conf
COPY level${LEVEL}/php.ini /usr/local/etc/php/conf.d/zz-lab.ini
COPY level${LEVEL}/fpm.conf /usr/local/etc/php-fpm.d/zz-lab.conf
COPY level${LEVEL}/src/ /var/www/html/
COPY level${LEVEL}/setup.sh /tmp/setup.sh

RUN sed -i 's/\r$//' /usr/local/bin/lab-entrypoint /tmp/setup.sh \
    && chmod +x /usr/local/bin/lab-entrypoint \
    && chown -R root:root /var/www/html \
    && chmod 755 /var/www/html \
    && sh /tmp/setup.sh \
    && rm /tmp/setup.sh

ENTRYPOINT ["lab-entrypoint"]
CMD ["sh", "-c", "php-fpm -D && exec nginx -g 'daemon off;'"]
