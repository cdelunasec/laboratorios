FROM php:8.2-apache

# LAB LOCAL INTENCIONALMENTE VULNERABLE (SSRF).
# Entorno controlado de práctica: se publica solo en 127.0.0.1. No exponer a ninguna red.
# Sin apt-get: curl (extensión y binario) ya viene en la imagen de PHP.
#
# Cada nivel tiene un "servicio interno" (php -S) que corre como el usuario
# `interno`, escucha solo en 127.0.0.1 y es el único que puede leer el flag.
# La app pública corre como www-data: el flag solo se alcanza haciendo que el
# servidor le pida algo al servicio interno (SSRF).

RUN useradd -r -M -d /nonexistent -s /usr/sbin/nologin interno

COPY common/php-base.ini /usr/local/etc/php/conf.d/00-lab.ini
COPY common/entrypoint.sh /usr/local/bin/lab-entrypoint
COPY common/start-interno.sh /usr/local/bin/start-interno
COPY common/lab.php /var/www/lab/lab.php

ARG LEVEL
ENV LAB_ID=ssrf-${LEVEL} LAB_LEVEL=${LEVEL}

COPY common/assets/ /var/www/html/assets/
COPY level${LEVEL}/apache.conf /etc/apache2/conf-available/docker-php.conf
COPY level${LEVEL}/php.ini /usr/local/etc/php/conf.d/99-level.ini
COPY level${LEVEL}/src/ /var/www/html/
COPY level${LEVEL}/setup.sh /tmp/setup.sh
COPY level${LEVEL}/flag.sh /opt/lab/flag.sh

RUN sed -i 's/\r$//' /usr/local/bin/lab-entrypoint /usr/local/bin/start-interno /tmp/setup.sh /opt/lab/flag.sh \
    && chmod +x /usr/local/bin/lab-entrypoint /usr/local/bin/start-interno \
    && mv /var/www/html/_interno /opt/interno \
    && chown -R root:root /var/www/html /opt/lab /opt/interno \
    && chmod 755 /var/www/html /opt/interno \
    && chmod 700 /opt/lab \
    && mkdir -p /var/lib/interno \
    && chown interno:interno /var/lib/interno \
    && chmod 700 /var/lib/interno \
    && sh /tmp/setup.sh \
    && rm /tmp/setup.sh

ENTRYPOINT ["lab-entrypoint"]
CMD ["apache2-foreground"]
